<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas/android.com/tools"
    xmlns:metadata="http://schemas.android.com/apk/metadata">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IPTV"
        android:usesCleartextTraffic="true"
        tools:ignore="GoogleAppIndexingWarning"
        tools:targetApi="34"
        metadata:experimentalFlags="android.media3.experimental"
        metadata:compatibilityModel="android.hardware.touchscreen" />

    <activity
        android:name=".presentation.MainActivity"
        android:exported="true"
        android:theme="@style/Theme.IPTV"
        android:windowSoftInputMode="adjustResize"
        android:configChanges="orientation|screenSize|smallestScreenSize|uiMode">

        <intent-filter>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent-filter>

        <meta-data
            android:name="com.google.android.tv.leanbacklauncher"
            android:value="true" />
    </activity>

    <activity
        android:name=".presentation.PlayerActivity"
        android:theme="@style/Theme.IPTV.Player"
        android:exported="false"
        android:configChanges="orientation|screenSize|smallestScreenSize" />

    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
    </provider>

</manifest>